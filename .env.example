# OPENAI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
# ------------------------------------------
# Option A: Qwen2.5-0.5B (~400MB) - Siêu nhẹ, đủ dùng cho lab
LOCAL_MODEL_PATH=./models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# Option B: Qwen2.5-1.5B (~1GB) - Nhẹ, hiểu tiếng Việt tốt hơn
# LOCAL_MODEL_PATH=./models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# Option C: Phi-3-mini-4k (~2.2GB) - Model gốc của lab
# LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
# Download: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf

# LAB CONFIG
# Options: openai | google | local
DEFAULT_PROVIDER=local
DEFAULT_MODEL=local
LOG_LEVEL=INFO
